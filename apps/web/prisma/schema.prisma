// CoreChain cloud database (Sprint 4). PostgreSQL, behind the Next.js API.
//
// This mirrors the phone's SQLite tables (apps/mobile/src/data/migrations.ts)
// column for column, because PowerSync streams these tables down to the device.
// Table and column names are therefore snake_case, and every syncable table
// keeps the sync-ready columns of decisions D6-D8: id (a UUID made on the
// device), created_at, updated_at, version, deleted_at.
//
// On top of what the phone stores, the server adds:
//   - organization_id on every table (a personal workspace in the MVP; real
//     teams later, with no data migration: decision D9),
//   - created_by (the signed-in user's id),
//   - project_id on the tables that hang off a drillhole, filled in by the API
//     from the drillhole, so PowerSync can sync "only projects I belong to".
//
// Sign-in tables (user, session, account, verification) are at the bottom,
// generated by Better Auth. E11-1 added the organizations table and
// user.organization_id; organization_id and created_by on every other table
// above stay plain text columns (no foreign key to organizations), because a
// personal workspace uses the user's own id as its organization id and never
// gets an organizations row of its own.
//
// hole_assignments, qaqc_exception_resolutions, qaqc_review_decisions and
// assay_results (E11-6, E12-2, E12-3, E13-3) are web-only records about the
// work, not part of it: none of them appear in sync-streams.yaml, so a
// manager's assignment, a QA/QC reviewer's note, or a laboratory result can
// never block or depend on a geologist's own offline logging.
//
// Rules the migration adds in raw SQL, because Prisma can't express them:
//   - sample_number_blocks: an EXCLUDE constraint on int4range(start_number,
//     start_number + size) per project, so two devices can never hold
//     overlapping blocks even if two requests race.
//   - samples: unique (project_id, lower(sample_number)) across deleted rows
//     too, because a sample number is a physical tag and is never reused.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CollarSource {
  gps
  manual
}

enum DrillholeStatus {
  planned
  drilling
  complete
  logged
}

// E11-7: set only by a resident / project manager from the team overview,
// never by the phone. See DrillholePriority in packages/domain/src/field.ts.
enum DrillholePriority {
  normal
  urgent
}

// packages/domain/src/qaqc.ts: which part of the chain a QA/QC account
// reviews (decision D15). Null on an account that isn't QA/QC, or that hasn't
// been scoped to a stage yet.
enum QaqcStage {
  core_logging
  sampling_custody
  laboratory_assays
}

enum QaqcDecisionType {
  accept
  hold
  reject
}

enum SampleType {
  primary
  standard
  blank
  duplicate
}

enum SampleStatus {
  created
  bagged
  dispatched
}

enum ControlType {
  standard
  blank
  duplicate
}

enum PhotoSubjectType {
  box
  interval
}

enum CustodyEventType {
  bagged
  sealed
  handed_over
  dispatched
  // E13-2: the laboratory's confirmation that a sample actually arrived.
  // Recorded once per sample by a laboratory account on the web, never by
  // the phone. A dispatched sample with no "received" event for it is how a
  // missing or short shipment is detected — no separate flag is stored.
  received
  correction
}

enum DispatchStatus {
  open
  dispatched
}

enum CodeCategory {
  lithology
  alteration_type
  alteration_intensity
  mineral
  mineral_style
  weathering
  structure_type
}

model Project {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id")
  createdBy         String    @map("created_by")
  name              String
  commodity         String?
  location          String?
  coordinateSystem  String    @map("coordinate_system")
  samplePrefix      String    @map("sample_prefix")
  nextSampleNumber  Int       @map("next_sample_number")
  qcStandardEveryN  Int       @map("qc_standard_every_n")
  qcBlankEveryN     Int       @map("qc_blank_every_n")
  qcDuplicateEveryN Int       @map("qc_duplicate_every_n")
  photoMaxMb        Float     @default(1.5) @map("photo_max_mb")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  version           Int
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  drillholes      Drillhole[]
  codes           CodeLibraryEntry[]
  samples         Sample[]
  qcDismissals    QcDismissal[]
  numberBlocks    SampleNumberBlock[]
  custodyEvents   CustodyEvent[]
  dispatches      Dispatch[]
  dispatchSamples DispatchSample[]

  @@index([organizationId])
  @@map("projects")
}

model Drillhole {
  id                    String            @id @db.Uuid
  organizationId        String            @map("organization_id")
  projectId             String            @map("project_id") @db.Uuid
  createdBy             String            @map("created_by")
  holeId                String            @map("hole_id")
  collarSource          CollarSource?     @map("collar_source")
  collarLatitude        Float?            @map("collar_latitude")
  collarLongitude       Float?            @map("collar_longitude")
  collarAccuracyM       Float?            @map("collar_accuracy_m")
  collarCapturedAt      DateTime?         @map("collar_captured_at") @db.Timestamptz(3)
  plannedAzimuthDeg     Float?            @map("planned_azimuth_deg")
  plannedInclinationDeg Float?            @map("planned_inclination_deg")
  plannedDepthM         Float             @map("planned_depth_m")
  actualFinalDepthM     Float?            @map("actual_final_depth_m")
  // Dates are chosen from a calendar on the phone and kept as plain days.
  startedAt             String?           @map("started_at")
  completedAt           String?           @map("completed_at")
  status                DrillholeStatus
  contractor            String?
  drillType             String?           @map("drill_type")
  diameter              String?
  note                  String?
  priority              DrillholePriority @default(normal)
  priorityNote          String?           @map("priority_note")
  createdAt             DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @map("updated_at") @db.Timestamptz(3)
  version               Int
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(3)

  project       Project                  @relation(fields: [projectId], references: [id])
  statusHistory DrillholeStatusHistory[]
  boxes         CoreBox[]
  runs          CoreRun[]
  intervals     LogInterval[]
  samples       Sample[]
  photos        Photo[]
  assignment    HoleAssignment?
  qaqcDecisions QaqcReviewDecision[]

  @@index([projectId])
  @@index([organizationId])
  @@map("drillholes")
}

// E11-2: who a project manager currently has working a hole. Web-only,
// deliberately not synced to the phone (like audit_events below): the
// geologist's own logging never depends on being assigned, so a wrong or
// missing assignment can never block field work. "Dynamic" per the story:
// the manager can reassign a hole at any time; this row is just their
// current call, not a locked-in schedule.
model HoleAssignment {
  id          String   @id @default(cuid())
  drillholeId String   @unique @map("drillhole_id") @db.Uuid
  userId      String   @map("user_id")
  assignedBy  String   @map("assigned_by")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  drillhole Drillhole @relation(fields: [drillholeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hole_assignments")
}

// E12-2: a QA/QC reviewer's note that an exception no longer needs their
// attention. Exceptions themselves are never stored — they are recomputed
// each time from the same evidence a geologist already entered (gaps,
// recovery, QC rates, custody) — so a resolution is keyed by the stable
// string that identifies the condition it applies to
// (packages/domain/src/qaqc.ts). Web-only, deliberately not synced to the
// phone, same as hole_assignments: a reviewer's own record-keeping never
// blocks or depends on a geologist's own logging.
model QaqcExceptionResolution {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  exceptionKey   String   @map("exception_key")
  reason         String
  resolvedBy     String   @map("resolved_by")
  resolvedAt     DateTime @default(now()) @map("resolved_at")

  @@unique([organizationId, exceptionKey])
  @@map("qaqc_exception_resolutions")
}

// E12-3: a QA/QC reviewer's accept/hold/reject decision on a hole, with a
// note. Append-only (D7): changing a decision adds a new row, never edits an
// old one, so the history a reviewer or auditor reads (E12-5) always shows
// who decided what and when. Web-only, deliberately not synced to the phone,
// same as hole_assignments.
model QaqcReviewDecision {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  drillholeId    String           @map("drillhole_id") @db.Uuid
  decision       QaqcDecisionType
  note           String?
  decidedBy      String           @map("decided_by")
  decidedAt      DateTime         @default(now()) @map("decided_at")

  drillhole Drillhole @relation(fields: [drillholeId], references: [id], onDelete: Cascade)

  @@index([drillholeId])
  @@map("qaqc_review_decisions")
}

model DrillholeStatusHistory {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id")
  projectId      String          @map("project_id") @db.Uuid
  drillholeId    String          @map("drillhole_id") @db.Uuid
  status         DrillholeStatus
  changedAt      DateTime        @map("changed_at") @db.Timestamptz(3)

  drillhole Drillhole @relation(fields: [drillholeId], references: [id])

  @@index([drillholeId])
  @@map("drillhole_status_history")
}

model CoreBox {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id") @db.Uuid
  createdBy      String    @map("created_by")
  drillholeId    String    @map("drillhole_id") @db.Uuid
  boxNumber      Int       @map("box_number")
  fromM          Float     @map("from_m")
  toM            Float     @map("to_m")
  note           String?
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  drillhole Drillhole @relation(fields: [drillholeId], references: [id])

  @@index([drillholeId])
  @@index([projectId])
  @@map("core_boxes")
}

model CoreRun {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id") @db.Uuid
  createdBy      String    @map("created_by")
  drillholeId    String    @map("drillhole_id") @db.Uuid
  fromM          Float     @map("from_m")
  toM            Float     @map("to_m")
  recoveredM     Float     @map("recovered_m")
  rqdPiecesM     Float?    @map("rqd_pieces_m")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  drillhole Drillhole @relation(fields: [drillholeId], references: [id])

  @@index([drillholeId])
  @@index([projectId])
  @@map("core_runs")
}

model CodeLibraryEntry {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id")
  projectId      String       @map("project_id") @db.Uuid
  createdBy      String       @map("created_by")
  category       CodeCategory
  code           String
  description    String
  hidden         Boolean      @default(false)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("code_library")
}

model LogInterval {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id")
  projectId           String    @map("project_id") @db.Uuid
  createdBy           String    @map("created_by")
  drillholeId         String    @map("drillhole_id") @db.Uuid
  fromM               Float     @map("from_m")
  toM                 Float     @map("to_m")
  lithology           String?
  alterationType      String?   @map("alteration_type")
  alterationIntensity String?   @map("alteration_intensity")
  mineral             String?
  mineralStyle        String?   @map("mineral_style")
  mineralPercent      Float?    @map("mineral_percent")
  weathering          String?
  structureType       String?   @map("structure_type")
  notes               String?
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)
  version             Int
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  drillhole Drillhole @relation(fields: [drillholeId], references: [id])

  @@index([drillholeId])
  @@index([projectId])
  @@map("log_intervals")
}

model Sample {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id")
  projectId      String       @map("project_id") @db.Uuid
  createdBy      String       @map("created_by")
  drillholeId    String       @map("drillhole_id") @db.Uuid
  sampleNumber   String       @map("sample_number")
  sampleType     SampleType   @map("sample_type")
  fromM          Float?       @map("from_m")
  toM            Float?       @map("to_m")
  standardRef    String?      @map("standard_ref")
  parentSampleId String?      @map("parent_sample_id") @db.Uuid
  note           String?
  status         SampleStatus
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  project         Project          @relation(fields: [projectId], references: [id])
  drillhole       Drillhole        @relation(fields: [drillholeId], references: [id])
  parent          Sample?          @relation("Duplicates", fields: [parentSampleId], references: [id])
  duplicates      Sample[]         @relation("Duplicates")
  custodyEvents   CustodyEvent[]
  dispatchSamples DispatchSample[]
  assayResults    AssayResult[]

  @@index([drillholeId])
  @@index([projectId])
  @@map("samples")
}

// E7-1: one line of a sample's chain of custody. Only ever added; a mistake is
// corrected by a "correction" event that points at it (corrects_event_id).
model CustodyEvent {
  id              String           @id @db.Uuid
  organizationId  String           @map("organization_id")
  projectId       String           @map("project_id") @db.Uuid
  createdBy       String           @map("created_by")
  sampleId        String           @map("sample_id") @db.Uuid
  eventType       CustodyEventType @map("event_type")
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(3)
  handledBy       String           @map("handled_by")
  location        String?
  recipient       String?
  note            String?
  dispatchId      String?          @map("dispatch_id") @db.Uuid
  correctsEventId String?          @map("corrects_event_id") @db.Uuid
  createdAt       DateTime         @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id])
  sample  Sample  @relation(fields: [sampleId], references: [id])

  @@index([projectId])
  @@index([sampleId])
  @@map("custody_events")
}

// E7-2: a batch of samples going to one laboratory. resultsReturnedAt (E13-3)
// is set once a laboratory account marks its results entry done; it stays
// null while entry is in progress, so a batch can be worked on across more
// than one sitting before being marked complete.
model Dispatch {
  id                 String         @id @db.Uuid
  organizationId     String         @map("organization_id")
  projectId          String         @map("project_id") @db.Uuid
  createdBy          String         @map("created_by")
  dispatchNumber     String         @map("dispatch_number")
  laboratory         String
  preparationRequest String?        @map("preparation_request")
  handoverAt         String?        @map("handover_at")
  status             DispatchStatus
  note               String?
  resultsReturnedAt  DateTime?      @map("results_returned_at") @db.Timestamptz(3)
  createdAt          DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @map("updated_at") @db.Timestamptz(3)
  version            Int
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(3)

  project      Project          @relation(fields: [projectId], references: [id])
  samples      DispatchSample[]
  assayResults AssayResult[]

  @@index([projectId])
  @@map("dispatches")
}

// E13-3: one analyte's result for one sample, returned by the laboratory
// against a dispatch. Web-only, like the QA/QC and manager tables above: E13
// is a web-only story, so a geologist's phone does not display results yet
// and this deliberately does not appear in sync-streams.yaml.
model AssayResult {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  dispatchId     String   @map("dispatch_id") @db.Uuid
  sampleId       String   @map("sample_id") @db.Uuid
  analyte        String
  value          Float?
  unit           String?
  belowDetection Boolean  @default(false) @map("below_detection")
  enteredBy      String   @map("entered_by")
  createdAt      DateTime @default(now()) @map("created_at")

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  sample   Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@index([sampleId])
  @@map("assay_results")
}

// E7-2: which samples are in which dispatch. A row is removed (deleted_at) when
// a sample is taken out of a dispatch that is still open.
model DispatchSample {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id")
  projectId      String    @map("project_id") @db.Uuid
  createdBy      String    @map("created_by")
  dispatchId     String    @map("dispatch_id") @db.Uuid
  sampleId       String    @map("sample_id") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  project  Project  @relation(fields: [projectId], references: [id])
  dispatch Dispatch @relation(fields: [dispatchId], references: [id])
  sample   Sample   @relation(fields: [sampleId], references: [id])

  @@index([projectId])
  @@index([dispatchId])
  @@index([sampleId])
  @@map("dispatch_samples")
}

model QcDismissal {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id")
  projectId      String      @map("project_id") @db.Uuid
  createdBy      String      @map("created_by")
  controlType    ControlType @map("control_type")
  reason         String
  createdAt      DateTime    @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("qc_dismissals")
}

model Photo {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id")
  projectId      String           @map("project_id") @db.Uuid
  createdBy      String           @map("created_by")
  drillholeId    String           @map("drillhole_id") @db.Uuid
  subjectType    PhotoSubjectType @map("subject_type")
  subjectId      String           @map("subject_id") @db.Uuid
  // Denormalised on purpose: a photo is never separated from its depth.
  holeId         String           @map("hole_id")
  boxNumber      Int?             @map("box_number")
  fromM          Float            @map("from_m")
  toM            Float            @map("to_m")
  fileName       String           @map("file_name")
  // The image itself lives in object storage under this key once uploaded;
  // null until the upload succeeds (photos upload separately from records).
  storageKey     String?          @map("storage_key")
  widthPx        Int              @map("width_px")
  heightPx       Int              @map("height_px")
  sizeBytes      Int              @map("size_bytes")
  capturedAt     DateTime         @map("captured_at") @db.Timestamptz(3)
  note           String?
  createdAt      DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @map("updated_at") @db.Timestamptz(3)
  version        Int
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  drillhole Drillhole @relation(fields: [drillholeId], references: [id])

  @@index([subjectType, subjectId])
  @@index([drillholeId])
  @@index([projectId])
  @@map("photos")
}

// A phone or tablet signed in to an account. "Remove this device" (E1-5) sets
// revoked_at, and the server then refuses its uploads.

model Device {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  name           String
  platform       String
  appVersion     String?   @map("app_version")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  numberBlocks SampleNumberBlock[]

  @@index([userId])
  @@map("devices")
}

// E6-4: a reserved run of sample numbers held by one device. See
// packages/domain/src/sampleBlocks.ts for how blocks are issued and used.

model SampleNumberBlock {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  startNumber    Int      @map("start_number")
  size           Int
  issuedAt       DateTime @map("issued_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id])
  device  Device  @relation(fields: [deviceId], references: [id])

  @@unique([projectId, startNumber])
  @@index([deviceId])
  @@map("sample_number_blocks")
}

// Decision D7 / sync rules: every accepted write also records who did what,
// when, and from which device. Append-only; nothing updates or deletes a row.

model AuditEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id") @db.Uuid
  actorUserId    String   @map("actor_user_id")
  deviceId       String?  @map("device_id") @db.Uuid
  entityTable    String   @map("entity_table")
  entityId       String   @map("entity_id") @db.Uuid
  action         String
  // The record's version before and after, and what changed.
  fromVersion    Int?     @map("from_version")
  toVersion      Int?     @map("to_version")
  changes        Json?
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)

  @@index([projectId, occurredAt])
  @@index([entityTable, entityId])
  @@map("audit_events")
}

// A team an admin groups accounts into (E11-1, decision D9). A user with no
// organizationId is still in a personal workspace, same as before teams
// existed: registerDevice() falls back to the user's own id as the
// organization id, exactly as it always has. Assigning a user to a team only
// changes where THEIR NEXT device registration (or re-pairing) lands; it does
// not retroactively move rows an already-registered device wrote under the
// old (personal) organization id, so a solo tester who joins a team keeps
// their prior work separate unless their phone is re-paired.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members User[]

  @@map("organizations")
}

// Sign-in tables, generated by Better Auth (`npx auth generate --config
// lib/auth.ts --output prisma/schema.prisma`) and kept in its default shape so
// upgrades stay easy. `role` is the tier from packages/domain/src/roles.ts.

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  role            String?
  banned          Boolean?         @default(false)
  banReason       String?
  banExpires      DateTime?
  organizationId  String?          @map("organization_id")
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  qaqcStage       QaqcStage?       @map("qaqc_stage")
  sessions        Session[]
  accounts        Account[]
  holeAssignments HoleAssignment[]

  @@unique([email])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// A pilot access request from the landing page. The admin sees new requests on
// the Users page and turns one into an account with a click. Not synced to
// phones, and not readable by the PowerSync role.
model AccessRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  company   String
  email     String
  // new -> accepted (an account was created for that email) or dismissed
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("access_requests")
}

// E10-2 / E10-6: feedback sent by testers (phone or web). The admin triages it
// on /admin/feedback. `client_id` is made on the phone so a message queued
// offline and retried is stored once. A screenshot is optional and offered by
// the phone only once it has this row's real id (see the screenshot route) —
// `storage_key` stays null until (and unless) that upload lands.
model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String?  @unique @map("client_id") @db.Uuid
  userId     String   @map("user_id")
  tier       String
  source     String // "android" or "web"
  appVersion String?  @map("app_version")
  device     String?
  screen     String?
  category   String // bug | idea | question
  message    String
  status     String   @default("new") // new | seen | planned | done
  note       String? // the admin's note, which the tester can see later
  storageKey String?  @map("storage_key") // the screenshot's file, if one was sent
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId])
  @@map("feedback")
}
