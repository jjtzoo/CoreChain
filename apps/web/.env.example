# Copy this file to `.env` (same folder) and fill in the real values.
# `.env` is ignored by git. Never commit it and never paste these into chat.
#
# Neon (Postgres, Singapore). In the Neon console press "Connect".
#
# DATABASE_URL: the POOLED string (hostname contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: the DIRECT string (no "-pooler"). Used by Prisma to create tables (migrations).
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Sign-in (Better Auth). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: an email to the owner for every feedback message (Resend, free tier).
# In resend.com sign up with the address that should receive them, then
# API Keys > Create API Key (permission "Sending access"). Leave both empty to
# switch the emails off. Set them in Vercel (Settings > Environment Variables).
RESEND_API_KEY=
FEEDBACK_NOTIFY_EMAIL=
